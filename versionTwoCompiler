function budgetCompareCalc(){
  
  var compiledSheetView = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Main Sheet")

  var rangeView = compiledSheetView.getLastRow()
  var budgetColumn = compiledSheetView.getRange(2,4, rangeView - 1).getValues()
  var spendColumn = compiledSheetView.getRange(2,5, rangeView - 1).getValues()

  Logger.log(budgetColumn)
  Logger.log(spendColumn)

  for(let i = 0; i < budgetColumn.length; i++){

    Logger.log(budgetColumn[i][0])



    if(budgetColumn[i][0] > spendColumn[i][0]){

      SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Main Sheet").getRange(i+2, 4).setBackground('#57cc99')
      SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Main Sheet").getRange(i+2, 5).setBackground('#57cc99')
      
    } else if (budgetColumn[i][0] < spendColumn[i][0]) {
      SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Main Sheet").getRange(i+2, 4).setBackground('#ef798a')
      SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Main Sheet").getRange(i+2, 5).setBackground('#ef798a')
    }

  }



}



















