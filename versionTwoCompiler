function normalizeHeadersFunc(header){

  var headerNormalized = header.toLowerCase().replace(/\s/g, '')
  return headerNormalized

}

//---------------------------- Specific for the Main Header sheets ---------------------------------------------------

function masterSheetHeaderMapper() {

  var mainCompilerSheetHeadersRaw = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Main Sheet")

  var getRowHeaders = mainCompilerSheetHeadersRaw.getRange(1,1,1, mainCompilerSheetHeadersRaw.getLastColumn()).getValues()

  getRowHeaders.forEach(function(header){
    for(let i = 0; i < header.length; i++){

      var completedNormalizedHeader = normalizeHeadersFunc(header[i])

      MAIN_HEADER_NORMALIZED_LIST.push(completedNormalizedHeader)
    
      // Logger.log(completedNormalizedHeader)

      // Logger.log("This is the main sheet with Headers: " + getRowHeaders)

    }
    
  })

  // Logger.log(MAIN_HEADER_NORMALIZED_LIST)

  return MAIN_HEADER_NORMALIZED_LIST

}


