function executeCalcs(){

  var getExteralSheetDataPrep = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Main Sheet")
  var usersRowCounter = getExteralSheetDataPrep.getLastRow()


  var budgetTotal = getExteralSheetDataPrep.getRange(2,4, usersRowCounter -1).getValues()
  var spendTotal = getExteralSheetDataPrep.getRange(2,5, usersRowCounter -1).getValues()

  var targetBudgetTotalDisplay = getExteralSheetDataPrep.getRange(usersRowCounter + 2, 4)
  var targetSpendTotalDisplay = getExteralSheetDataPrep.getRange(usersRowCounter + 2, 5)
  var differenceDisplay = getExteralSheetDataPrep.getRange(usersRowCounter + 3, 5)

  var indicatorNotice = getExteralSheetDataPrep.getRange(usersRowCounter + 3, 4)




  targetBudgetTotalDisplay.setFormula(`=SUM(${budgetTotal})`)
  targetSpendTotalDisplay.setFormula(`=SUM(${spendTotal})`)

  if(targetBudgetTotalDisplay.getValue() > targetSpendTotalDisplay.getValue()) {
    Logger.log("We're calculating the difference and you are in budget")

    var inBudgetDifference = targetBudgetTotalDisplay.getValue() - targetSpendTotalDisplay.getValue()

    differenceDisplay.setValue(inBudgetDifference).setBackground("#57cc99")
    indicatorNotice.setValue("We're In Budget").setBackground("#57cc99")

  } else if (targetSpendTotalDisplay.getValue() > targetBudgetTotalDisplay.getValue()){

    var inBudgetDifference = targetBudgetTotalDisplay.getValue() - targetSpendTotalDisplay.getValue()

    Logger.log(inBudgetDifference)

    differenceDisplay.setValue(inBudgetDifference).setBackground("#ef798a")
    indicatorNotice.setValue("We're Outside Budget").setBackground("#ef798a")

  }



}

