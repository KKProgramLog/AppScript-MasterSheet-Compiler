function externalSheetOpener(sheetName, userLink) {

  var openlink = SpreadsheetApp.openByUrl(userLink).getSheetByName(sheetName)

  var externalUserHeaderRowCounter = openlink.getLastRow()
  var externalUserHeaderColumnCounter = openlink.getLastColumn()

  // Logger.log(`This Sheet Belongs to: ${sheetName}` + userLink) 
  // Logger.log(externalUserHeaderRowCounter)
  // Logger.log(openlink)


  var userCollectedHeaders = openlink.getRange(1,1,1, externalUserHeaderColumnCounter).getValues()

  userCollectedHeaders[0].forEach(function(externalheader){
    
    var nomralizedExternalHeaders = normalizeHeadersFunc(externalheader)

    // Logger.log(sheetName)


    var key = sheetName[0].toLowerCase().replace(/\s/g, '')

    if(externalSheetArray[key]){

      externalSheetArray[key].push(nomralizedExternalHeaders)

    } else {

      externalSheetArray[key] = [nomralizedExternalHeaders]

    }
    // heetheaders = normalizeHeadersFunc(externalheader[index])
    //   EXTERNAL_HEADER_NORMALIZED_LIST[sheetName] = nomralizedExternalHeaders

    Logger.log("This is my normalizedHeaders: " + nomralizedExternalHeaders)

    // EXTERNAL_HEADER_NORMALIZED_LIST.push(nomralizedExternalHeaders)


  })

  // var counter = 0
  // counter++



  // Logger.log(counter)
  // Logger.log(externalSheetArray)
  // Logger.log(externalSheetArray.johnsheet[0])

  return externalSheetArray

}


