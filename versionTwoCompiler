function normalizeHeadersFunc (header){

  var headerNormalized = header.toLowerCase().replace(/\s/g, '')
  return headerNormalized

}

function masterSheetHeaderMapper() {

  var mainCompilerSheetHeadersRaw = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Main Sheet")

  var getRowHeaders = mainCompilerSheetHeadersRaw.getRange(1,1,1, mainCompilerSheetHeadersRaw.getLastColumn()).getValues()

  getRowHeaders.forEach(function(header){
    Logger.log(header)
    for(let i = 0; i < header.length; i++){

      var completedNormalizedHeader = normalizeHeadersFunc(header[i])

      MAIN_HEADER_NORMALIZED_LIST.push(completedNormalizedHeader)
    
      // Logger.log(completedNormalizedHeader)

      // Logger.log("This is the main sheet with Headers: " + getRowHeaders)

    }
  })

  // Logger.log(MAIN_HEADER_NORMALIZED_LIST)

  return normalizedHeaderComparer(MAIN_HEADER_NORMALIZED_LIST)

}

function externalSheetOpener(sheetName, userLink) {

  var openlink = SpreadsheetApp.openByUrl(userLink).getSheetByName(sheetName)

  var externalUserHeaderRowCounter = openlink.getLastRow()
  var externalUserHeaderColumnCounter = openlink.getLastColumn()

  // Logger.log(`This Sheet Belongs to: ${sheetName}` + userLink) working
  // Logger.log(externalUserHeaderRowCounter)
  // Logger.log(externalUserHeaderColumnCounter)

  var userCollectedHeaders = openlink.getRange(1,1,1, externalUserHeaderColumnCounter).getValues()

  userCollectedHeaders.forEach(function(externalheader){

    for(let i = 0; i <  userCollectedHeaders.length; i++) {
      sheetheaders = normalizeHeadersFunc(externalheader[i])
      EXTERNAL_HEADER_NORMALIZED_LIST.sheetName = sheetheaders


    }

  })


  
  Logger.log(sheetheaders)
  Logger.log(EXTERNAL_HEADER_NORMALIZED_LIST)

  

}


function userLinkSplitter(){
  var externalUserLinksPage = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("usersExternalSheets")
  var usersRowCounter = externalUserLinksPage.getLastRow()
  var usersColumnCounter = externalUserLinksPage.getLastColumn()

  var getUserDataNames = externalUserLinksPage.getRange(2, 4, usersRowCounter -1, 1).getValues()
  var getUserDataSheetLinks = externalUserLinksPage.getRange(2, 1, usersRowCounter -1, 1).getValues()


  Logger.log(usersRowCounter)
  Logger.log(usersColumnCounter)
  Logger.log(getUserDataNames)
  Logger.log(getUserDataSheetLinks)


  getUserDataNames.forEach(function(name, index){


    // checking that links and sheet names aren't empty
    if(name != "" && getUserDataSheetLinks[index][0] != ""){

      var providedLinks = getUserDataSheetLinks[index][0]

      externalSheetOpener(name, providedLinks)

      // Logger.log(`This Sheet Belongs to: ${name}` + getUserDataSheetLinks[index][0]) - working 

      // Logger.log(`You've made it to the next level: ${name}`) - working
    }


  })


}

